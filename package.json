{
	"name": "remix-dashboard",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": [
		"**/*.css",
		"./src/main.tsx"
	],
	"scripts": {
		"build": "vite build && tsc -b",
		"check:types": "tsc -b",
		"dev": "vite",
		"format": "oxfmt .",
		"generate:types": "node scripts/types.js",
		"lint": "oxlint .",
		"lint:directives": "node tools/architecture/directive-guard.js",
		"lint:fix": "oxlint --fix .",
		"machine-translate": "inlang machine translate --project project.inlang",
		"preview": "vite preview",
		"test:architecture": "vitest run --project server tools/architecture",
		"test:browser": "vitest --project \"browser*\"",
		"test:server": "vitest --project server",
		"test:unit": "vitest"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@fontsource-variable/rethink-sans": "5.3.0",
		"@hookform/resolvers": "7.0.3",
		"@tanstack/react-hotkeys": "0.22.2",
		"@tanstack/react-query": "5.107.1",
		"@tanstack/react-query-devtools": "5.107.1",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-table": "9.3.1",
		"class-variance-authority": "0.7.1",
		"cn": "0.5.2",
		"es-toolkit": "1.53.2",
		"lucide-react": "1.70.0",
		"motion": "14.10.1",
		"next-themes": "0.4.6",
		"openapi-fetch": "0.17.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-hook-form": "7.91.0",
		"sonner": "2.0.8",
		"unique-names-generator": "4.7.1",
		"vaul": "1.1.2",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@inlang/cli": "3.6.0",
		"@inlang/paraglide-js": "3.2.1",
		"@rolldown/plugin-babel": "0.3.0",
		"@tailwindcss/vite": "4.3.5",
		"@tanstack/router-devtools": "1.167.3",
		"@tanstack/router-plugin": "1.169.0",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"@vitest/browser-playwright": "5.1.0",
		"babel-plugin-react-compiler": "1.0.0",
		"lefthook": "2.2.2",
		"openapi-typescript": "7.13.0",
		"oxfmt": "0.77.0",
		"oxlint": "1.92.0",
		"playwright": "1.65.0",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "1.4.0",
		"typescript": "7.0.2",
		"vite": "8.3.6",
		"vitest": "5.1.0",
		"vitest-browser-react": "2.3.0"
	},
	"packageManager": "pnpm@12.18.0"
}
