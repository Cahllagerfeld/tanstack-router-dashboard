{
	"name": "remix-dashboard",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build && tsc -b",
		"check:types": "tsc --noEmit",
		"dev": "vite",
		"format": "oxfmt .",
		"generate:types": "node scripts/types.js",
		"lint": "oxlint --fix .",
		"machine-translate": "inlang machine translate --project project.inlang",
		"preview": "vite preview",
		"test:browser": "vitest --project \"browser*\"",
		"test:server": "vitest --project server",
		"test:unit": "vitest"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@hookform/resolvers": "^6.0.0",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-query-devtools": "^5.102.8",
		"@tanstack/react-router": "^1.170.33",
		"@tanstack/react-table": "^9.2.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"es-toolkit": "^1.52.0",
		"lucide-react": "^1.43.0",
		"next-themes": "^0.4.6",
		"openapi-fetch": "^0.17.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.87.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"unique-names-generator": "^4.7.1",
		"vaul": "^1.1.2",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@inlang/cli": "3.4.4",
		"@inlang/paraglide-js": "2.29.2",
		"@rolldown/plugin-babel": "0.2.4",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/router-devtools": "1.167.2",
		"@tanstack/router-plugin": "1.168.48",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/browser-playwright": "5.0.5",
		"babel-plugin-react-compiler": "1.0.0",
		"lefthook": "2.2.2",
		"openapi-typescript": "7.13.0",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"playwright": "1.64.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"vitest-browser-react": "2.3.0"
	},
	"packageManager": "pnpm@12.16.0"
}
